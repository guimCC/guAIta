# guAIta environment template
#
# Copy this file to .env and fill in local secrets/keys.
# Do not commit .env.

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/guaita.db
DEVICE_TOKEN=replace_with_shared_device_token

# Voice escalation demo
# Use a real consenting recipient number in E.164 format, for example +34612345678.
CALLS_ENABLED=false
CIVIL_PROTECTION_DEMO_NUMBER=replace_with_demo_recipient_number
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
ELEVENLABS_AGENT_ID=replace_with_elevenlabs_agent_id
ELEVENLABS_AGENT_PHONE_NUMBER_ID=replace_with_elevenlabs_phone_number_id
ELEVENLABS_WEBHOOK_TOKEN=replace_with_webhook_token

# Google AI
GEMINI_API_KEY=replace_with_gemini_api_key

# Local tunnel
# Required for ElevenLabs acknowledgement/post-call webhooks.
# Use this when exposing the local server through ngrok or another tunnel.
PUBLIC_TUNNEL_URL=

# Web app
VITE_API_BASE_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000

# Map
# Preferred style: MapTiler Outdoor v4.
# Fallback style is used when no MapTiler key is configured.
VITE_MAP_PROVIDER=maptiler
VITE_MAPTILER_KEY=replace_with_maptiler_key
VITE_MAPTILER_STYLE_ID=outdoor-v4
VITE_MAP_FALLBACK_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional direct style override. Leave empty unless you want to bypass provider logic.
VITE_MAP_STYLE_URL=

# Initial map viewport: Collserola / Barcelona.
VITE_MAP_CENTER_LAT=41.4197
VITE_MAP_CENTER_LNG=2.1029
VITE_MAP_INITIAL_ZOOM=12.2
